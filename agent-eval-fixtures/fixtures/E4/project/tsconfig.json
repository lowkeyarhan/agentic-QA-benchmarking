{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "@wdio/mocha-framework", "@wdio/globals/types"],
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["./pages/*"]
    }
  },
  "include": [
    "./test/**/*.ts",
    "./pages/**/*.ts",
    "./wdio.conf.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
