# Batch judge model credentials.
# Use `google` or `openai`. If blank, the harness picks Google when
# GOOGLE_API_KEY exists, otherwise OpenAI when OPENAI_API_KEY exists.
DEEPEVAL_JUDGE_PROVIDER=

# Google judge settings.
GOOGLE_API_KEY=
# This is the batch judge model, not the Gemini CLI agent model. Use a
# Gemini model supported by Google GenAI structured output; do not put Gemma
# agent model names here. Use gemini-2.5-pro when your quota allows it.
DEEPEVAL_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Confident AI dashboard upload for combined DeepEval reports.
# You can set this with: .venv/bin/deepeval login --save=dotenv:.env
CONFIDENT_API_KEY=

# Optional fallback if you configure DeepEval to use OpenAI instead.
OPENAI_API_KEY=
DEEPEVAL_OPENAI_MODEL=gpt-5-nano

# Benchmark cases. Use a QA Bench suite for production comparisons, `all` for
# every fixture, or a comma-separated subset for local debugging.
# Suites:
#   suite:qa-production        every available QA lifecycle fixture
#   suite:qa-core              balanced vendor-comparison subset
#   suite:qa-smoke             fast authoring/repair/planning/runtime sanity suite
#   suite:qa-lifecycle-extended broad advanced QA lifecycle suite
# By default, benchmark/.env overrides exported shell variables so local runs
# are reproducible. Set BENCHMARK_ENV_FILE_OVERRIDE=0 in the shell when you
# intentionally want exported variables to win.
BENCHMARK_ENV_FILE_OVERRIDE=1
BENCHMARK_EVAL_IDS=suite:qa-production
# Append one-off evals without replacing the base suite/subset above.
# Supports comma-separated eval ids or suite:<name>; duplicates are removed.
BENCHMARK_EXTRA_EVAL_IDS=
# Batch size options: 5, 10, 20, 50, or all. Use offset to page through chunks.
BENCHMARK_EVAL_LIMIT=all
BENCHMARK_EVAL_OFFSET=0
# Agent entries can be plain names or inline model variants, e.g.
# BENCHMARK_AGENTS=supatest:premium,cursor:auto,codex:gpt-5.5,gemini:gemini-3.1-flash-lite
BENCHMARK_AGENTS=supatest,cursor,codex,gemini
# Prompt profile:
#   qa      shared QA coaching for every agent (default, best for task ability)
#   minimal task + mode + cwd boundary, without shared QA coaching
#   raw     fixture task only, plus failure log when present
BENCHMARK_PROMPT_PROFILE=qa
# Tool fairness. Host-level tools listed here are hidden from benchmark-launched
# agent PATH. Keep `rtk` here unless you are intentionally doing local debugging.
# Supatest RTK support should come from its own compiled runtime/toolchain.
BENCHMARK_HIDE_HOST_TOOLS=rtk

# Supatest CLI settings.
# Leave BENCHMARK_SUPATEST_BINARY blank to use `supatest` from PATH.
BENCHMARK_SUPATEST_BINARY=
# Leave blank to use benchmark/.supatest/settings.json.
# Set explicitly if you want a different dedicated Supatest benchmark project.
BENCHMARK_SUPATEST_PROJECT_ID=
BENCHMARK_SUPATEST_MODEL=premium
# Use Supatest stream-json machine mode so final usage/cost telemetry is emitted.
BENCHMARK_SUPATEST_MACHINE_MODE=1
# Supatest launches emit safe eval diagnostics by default. Set to 0 to disable.
BENCHMARK_SUPATEST_EVAL_TELEMETRY=1
# Optional for CI. Local headless runs can use `supatest login`.
BENCHMARK_SUPATEST_API_KEY=

# Optional Supatest eval dashboard upload. Create this key from the eval
# dashboard Settings -> API Keys page. This is separate from CONFIDENT_API_KEY
# and separate from the Supatest CLI/reporter API key above.
BENCHMARK_SUPATEST_EVAL_DASHBOARD_API_KEY=
BENCHMARK_SUPATEST_EVAL_DASHBOARD_URL=https://evals-dashboard.supatest.ai
BENCHMARK_SUPATEST_EVAL_DASHBOARD_RUN_NAME=Benchmark {run_id}
BENCHMARK_SUPATEST_EVAL_DASHBOARD_TIMEOUT_SECONDS=30
# Set to 1 if upload failure should make the benchmark exit non-zero after
# local results are written.
BENCHMARK_SUPATEST_EVAL_DASHBOARD_STRICT=

# Agent model settings. These feed built-in command templates and `{model}` /
# `{model_arg}` placeholders in custom templates. Inline BENCHMARK_AGENTS
# entries like `codex:gpt-5` override these family defaults for that run.
BENCHMARK_CURSOR_MODEL=auto
BENCHMARK_CODEX_MODEL=gpt-5.5
BENCHMARK_GEMINI_MODEL=gemini-3.1-flash-lite

# Run controls.
BENCHMARK_MAX_ITERATIONS=75
BENCHMARK_TIMEOUT_SECONDS=600
BENCHMARK_PARALLELISM=3
BENCHMARK_RUNS_DIR=runs
BENCHMARK_RESULTS_DIR=results
# Score an existing runs/<run-id> directory without launching agents.
# Equivalent CLI: ./run_benchmark.py --score-existing <run-id>
BENCHMARK_SCORE_EXISTING_RUN_ID=
# Set to 1 if you want the ordered terminal scoreboard repeated at the end.
BENCHMARK_PRINT_FINAL_TABLE=
# Set to 1 only if you intentionally want to skip the startup judge API check.
BENCHMARK_DISABLE_JUDGE_PREFLIGHT=
# One-call scoring prompt budget. Lower this if the judge model rejects the
# request for context length, raise it for more evidence per case.
# For large runs, set BENCHMARK_JUDGE_BATCH_SIZE to keep evidence per case high
# without sending every result in one giant judge request.
BENCHMARK_BATCH_TOTAL_CASE_CHARS=180000
BENCHMARK_BATCH_CASE_CHARS=5000
BENCHMARK_JUDGE_BATCH_SIZE=
# Optional token-cost estimates. Leave blank to report token counts only.
# Use TOTAL when the agent exposes only a combined token count. Use INPUT /
# OUTPUT when the agent exposes split usage. Values are USD per 1M tokens.
BENCHMARK_TOKEN_PRICE_SUPATEST_TOTAL_PER_1M=
BENCHMARK_TOKEN_PRICE_SUPATEST_INPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_SUPATEST_OUTPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_CURSOR_TOTAL_PER_1M=
BENCHMARK_TOKEN_PRICE_CURSOR_INPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_CURSOR_OUTPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_CODEX_TOTAL_PER_1M=
BENCHMARK_TOKEN_PRICE_CODEX_INPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_CODEX_OUTPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_GEMINI_TOTAL_PER_1M=
BENCHMARK_TOKEN_PRICE_GEMINI_INPUT_PER_1M=
BENCHMARK_TOKEN_PRICE_GEMINI_OUTPUT_PER_1M=
# Overall score = QA average * QA weight + token-efficiency score * remaining
# weight + time-efficiency score * time weight. Keep QA dominant so cheap or
# fast failures do not rank well. Defaults are 70% QA, 15% tokens, 15% time.
BENCHMARK_OVERALL_QA_WEIGHT=0.7
BENCHMARK_OVERALL_TIME_WEIGHT=0.15
# Token efficiency baselines only use runs at or above this QA score. Accepts
# either 0.8 or 80 for 80%.
BENCHMARK_TOKEN_BASELINE_QA_THRESHOLD=0.8
# Optional explicit token totals for opaque agents/proxies. Leave blank unless
# another trusted meter provides a per-run total that the transcript cannot show.
BENCHMARK_TOKEN_USAGE_FALLBACK_SUPATEST_TOKENS=
BENCHMARK_TOKEN_USAGE_FALLBACK_CURSOR_TOKENS=
BENCHMARK_TOKEN_USAGE_FALLBACK_CODEX_TOKENS=
BENCHMARK_TOKEN_USAGE_FALLBACK_GEMINI_TOKENS=
BENCHMARK_TOKEN_USAGE_FALLBACK_TOKENS=
# Set to 1 only when you intentionally want live-device evals to run even if
# the local Maestro preflight cannot see the required device.
BENCHMARK_DISABLE_PREFLIGHT=

# Agent command templates.
# Placeholders:
#   {prompt}     full shell-quoted prompt
#   {task}       fixture task only, shell-quoted
#   {mode}       build/fix/plan
#   {cwd}        shell-quoted fixture project cwd
#   {logs_file}  shell-quoted failure.log path or empty string
#   {model}      shell-quoted selected model, or empty string
#   {model_arg}  `--model <model>` when a model is selected, else empty
#   {project_id} shell-quoted Supatest project id or empty string
# If a built-in command exists for cursor, codex, or gemini, the matching
# BENCHMARK_<AGENT>_CMD can be left blank.
BENCHMARK_CLAUDE_CMD=
BENCHMARK_CURSOR_CMD=
BENCHMARK_CODEX_CMD=
BENCHMARK_GEMINI_CMD=
BENCHMARK_SUPATEST_CMD=
