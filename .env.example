# DeepEval judge model credentials.
# Use your Google AI Studio API key here.
GOOGLE_API_KEY=
# This is the DeepEval judge model, not the Gemini CLI agent model. Use a
# Gemini model supported by Google GenAI structured output; do not put Gemma
# agent model names here. Use gemini-2.5-pro when your quota allows it.
DEEPEVAL_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Confident AI dashboard upload for combined DeepEval reports.
# You can set this with: .venv/bin/deepeval login --save=dotenv:.env
CONFIDENT_API_KEY=

# Optional fallback if you configure DeepEval to use OpenAI instead.
OPENAI_API_KEY=

# Benchmark cases. Use `all` for every fixture, or a comma-separated subset.
BENCHMARK_EVAL_IDS=all
BENCHMARK_AGENTS=supatest,cursor,codex,gemini

# Supatest CLI settings.
# Leave BENCHMARK_SUPATEST_BINARY blank to use `supatest` from PATH.
BENCHMARK_SUPATEST_BINARY=
# Leave blank to use benchmark/.supatest/settings.json.
# Set explicitly if you want a different dedicated Supatest benchmark project.
BENCHMARK_SUPATEST_PROJECT_ID=
BENCHMARK_SUPATEST_MODEL=premium
# Optional for CI. Local headless runs can use `supatest login`.
BENCHMARK_SUPATEST_API_KEY=

# Run controls.
BENCHMARK_MAX_ITERATIONS=75
BENCHMARK_TIMEOUT_SECONDS=600
BENCHMARK_PARALLELISM=3
BENCHMARK_RUNS_DIR=runs
BENCHMARK_RESULTS_DIR=results
# Set to 1 if you want the ordered terminal scoreboard repeated at the end.
BENCHMARK_PRINT_FINAL_TABLE=
# Set to 1 only if you intentionally want to skip the startup judge model check.
BENCHMARK_DISABLE_JUDGE_PREFLIGHT=
# Set to 1 only when you intentionally want live-device evals to run even if
# the local Maestro preflight cannot see the required device.
BENCHMARK_DISABLE_PREFLIGHT=

# Agent command templates.
# Placeholders:
#   {prompt}     full shell-quoted prompt
#   {task}       fixture task only, shell-quoted
#   {mode}       build/fix/plan
#   {cwd}        shell-quoted fixture project cwd
#   {logs_file}  shell-quoted failure.log path or empty string
#   {project_id} shell-quoted Supatest project id or empty string
BENCHMARK_CLAUDE_CMD=
BENCHMARK_CURSOR_CMD='cursor-agent --print --force --model auto {prompt}'
BENCHMARK_CODEX_CMD='codex exec -C {cwd} --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox {prompt}'
BENCHMARK_GEMINI_CMD='gemini --model gemini-3.1-flash-lite --prompt {prompt} --yolo --skip-trust'
BENCHMARK_SUPATEST_CMD=
